SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-chave-anon-aqui
# Obrigatória com RLS fechado (Settings → API → service_role — NÃO publique):
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui
SUPABASE_TABLE=formulario
SUPABASE_STORAGE_BUCKET=Form
SUPABASE_FUP_FILE=relatorio_fup.xlsm
SUPABASE_CODIGOS_FILE=fornecedores_codigos.json
SUPABASE_CONTAS_FILE=contas_fornecedor.json
SUPABASE_PRAZO_FILE=prazo_resposta.json
FORM_BASE_URL=http://localhost:8501

# Segurança de login
MAX_FALHAS_LOGIN=5
BLOQUEIO_LOGIN_MINUTOS=15
SENHA_VALIDADE_DIAS=90
OTP_VALIDADE_MINUTOS=10
ENABLE_2FA=false

# E-mail — escolha UMA opção:
# No MVP o reset de senha usa o dashboard (senha temporária).
# Em PRODUÇÃO, valide OTP/e-mail com domínio DNS — ver DEPLOY_PRODUCAO.md §12.1

# Opção A (recomendada): Resend — API key, sem senha de Outlook/Gmail
# Crie em https://resend.com → API Keys
# Para teste: EMAIL_FROM=onboarding@resend.dev
# Em produção: domínio verificado (SPF/DKIM) aprovado pela TI
RESEND_API_KEY=
EMAIL_FROM=

# Opção B: SMTP clássico (Outlook/Gmail)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
